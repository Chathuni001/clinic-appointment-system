generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/////////////////////////////////////////////////////
// PRIVILEGE MODEL
/////////////////////////////////////////////////////
model Privilege {
  id          Int             @id @default(autoincrement())
  name        String          @unique // e.g., "CREATE_DOCTOR", "DELETE_USER"
  description String?         // What this privilege does
  roles       RolePrivilege[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Audit
  createdById Int?
  updatedById Int?
  deletedById Int?

  createdBy   User? @relation("PrivilegeCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("PrivilegeUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("PrivilegeDeletedBy", fields: [deletedById], references: [id])
}

/////////////////////////////////////////////////////
// ROLE MODEL
/////////////////////////////////////////////////////
model Role {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Audit fields
  createdById Int?
  updatedById Int?
  deletedById Int?

  createdBy User? @relation("RoleCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("RoleUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("RoleDeletedBy", fields: [deletedById], references: [id])

  // Users in this role
  users User[]
  rolePrivileges RolePrivilege[] 
}

/////////////////////////////////////////////////////
// ROLE-PRIVILEGE MODEL
/////////////////////////////////////////////////////
model RolePrivilege {
  roleId      Int
  privilegeId Int
  role        Role      @relation(fields: [roleId], references: [id])
  privilege   Privilege @relation(fields: [privilegeId], references: [id])

  @@id([roleId, privilegeId]) // Composite primary key
}

/////////////////////////////////////////////////////
// USER MODEL
/////////////////////////////////////////////////////
model User {
  id        Int       @id @default(autoincrement())
  name      String
  username  String    @unique
  password  String
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Role relation 
  roleId Int?
  role   Role? @relation(fields: [roleId], references: [id])

  // Audit fields (Self-relations)
  createdById Int?
  updatedById Int?
  deletedById Int?

  createdBy User? @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("UserDeletedBy", fields: [deletedById], references: [id])

  // Reverse relations for User auditing
  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")
  deletedUsers User[] @relation("UserDeletedBy")

// Reverse relations for Privilege auditing
  createdPrivileges Privilege[] @relation("PrivilegeCreatedBy")
  updatedPrivileges Privilege[] @relation("PrivilegeUpdatedBy")
  deletedPrivileges Privilege[] @relation("PrivilegeDeletedBy")


  // Reverse relations for Role auditing
  createdRoles Role[] @relation("RoleCreatedBy")
  updatedRoles Role[] @relation("RoleUpdatedBy")
  deletedRoles Role[] @relation("RoleDeletedBy")

  // Reverse relations for Doctor auditing (Fixed Typos)
  createdDoctors Doctor[] @relation("DoctorCreatedBy")
  updatedDoctors Doctor[] @relation("DoctorUpdatedBy")
  deletedDoctors Doctor[] @relation("DoctorDeletedBy")

  // Reverse relations for Specialty auditing
  createdSpecialities Specialty[] @relation("SpecialtyCreatedBy")
  updatedSpecialities Specialty[] @relation("SpecialtyUpdatedBy")
  deletedSpecialities Specialty[] @relation("SpecialtyDeletedBy")

  // Reverse relations for Appointment auditing
  createdAppointments Appointment[] @relation("AppointmentCreatedBy")
  updatedAppointments Appointment[] @relation("AppointmentUpdatedBy")
  deletedAppointments Appointment[] @relation("AppointmentDeletedBy")
}

/////////////////////////////////////////////////////
// DOCTOR MODEL
/////////////////////////////////////////////////////
model Doctor {
  id          Int         @id @default(autoincrement())
  name        String
  image       String?
  specialtyId Int?
  specialty   Specialty? @relation(fields: [specialtyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Audit fields
  createdById Int?
  updatedById Int?
  deletedById Int?

  createdBy User? @relation("DoctorCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("DoctorUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("DoctorDeletedBy", fields: [deletedById], references: [id])

  appointments Appointment[]
}

/////////////////////////////////////////////////////
// Specialty MODEL
/////////////////////////////////////////////////////
model Specialty {
  id   Int    @id @default(autoincrement())
  name String @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Audit fields
  createdById Int?
  updatedById Int?
  deletedById Int?

  createdBy User? @relation("SpecialtyCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("SpecialtyUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("SpecialtyDeletedBy", fields: [deletedById], references: [id])

  // Relation back to doctors
  doctors Doctor[]
}

/////////////////////////////////////////////////////
// APPOINTMENT MODEL
/////////////////////////////////////////////////////
model Appointment {
  id          Int      @id @default(autoincrement())
  patientName String
  date        DateTime

  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  // Added Audit fields to match your design pattern
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById Int?
  updatedById Int?
  deletedById Int?

  createdBy User? @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("AppointmentDeletedBy", fields: [deletedById], references: [id])
}
